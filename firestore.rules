rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Blogs collection: publicly readable, writable by authenticated admins
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Config collection (SEO templates, format toggles): publicly readable, writable by authenticated admins
    match /config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
